{
  "name": "resonance",
  "version": "1.0.0",
  "private": true,
  "description": "An offline mesh network made of sound.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && vite preview --port 4173 --open",
    "beacon": "vite build && vite preview --port 4173 --open /beacon.html",
    "serve": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "ios:web": "npm run build && rm -rf ios/Sources/Resonance/Web && cp -R dist ios/Sources/Resonance/Web"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
